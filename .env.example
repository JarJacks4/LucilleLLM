# LucilleLLM Environment Configuration
# Copy this file to .env and fill in your values

# Required
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_CLOUD_PROJECT=escape-self-care-505618
FIREBASE_CREDENTIAL_PATH=path/to/serviceAccount.json

# Internal service-to-service auth secret. Invent your own value (e.g. `openssl rand -hex 32`).
# Leave empty if you only use Firebase Auth and don't need backend-to-backend calls.
# In production, store this in Google Secret Manager instead of .env.
INTERNAL_SERVICE_KEY=

# Environment
ENVIRONMENT=development

# Model configuration
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
FAISS_INDEX_PATH=./faiss_vecdb

# Image-based Mood Analysis (OpenAI Vision)
# Vision-capable model used to classify facial emotion from an uploaded image.
# gpt-4o is more accurate; gpt-4o-mini is cheaper and also supports vision.
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional dedicated API key for the vision model.
# Leave BLANK to reuse OPENAI_API_KEY above.
# >>> ADD YOUR OPENAI API KEY HERE (only if you want vision billed separately) <<<
OPENAI_VISION_API_KEY=
# Max image upload size (MB) accepted by the mood-analysis endpoint
MAX_IMAGE_SIZE_MB=10

# Rate limiting (requests per window)
RATE_LIMIT_CHAT=10
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTLs (seconds)
CACHE_TTL_USER_PROFILE=60
CACHE_TTL_EFFECTIVENESS=120
CACHE_TTL_EMOTION=300
CACHE_MAX_SIZE=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Metrics
METRICS_ENABLED=true

# Dependency Detection Thresholds
DEPENDENCY_MAX_MESSAGES_PER_HOUR=20
DEPENDENCY_MAX_SESSIONS_PER_DAY=8
DEPENDENCY_NIGHTTIME_START_HOUR=0
DEPENDENCY_NIGHTTIME_END_HOUR=5
DEPENDENCY_NIGHTTIME_THRESHOLD=5
DEPENDENCY_ESCALATION_RATIO=1.5
DEPENDENCY_CONSECUTIVE_DAYS_THRESHOLD=14
DEPENDENCY_COOLDOWN_MINUTES=30

# Cultural Competence
CULTURAL_BIAS_CHECK_ENABLED=true
CULTURAL_DEFAULT_COUNTRY=US

# Audio Storage (GCS)
GCS_AUDIO_BUCKET=your-bucket-name
GCS_AUDIO_PREFIX=soundscapes/
GCS_SIGNED_URL_EXPIRY_MINUTES=60

# Local Audio Fallback (for development without GCS)
LOCAL_AUDIO_FALLBACK=false
LOCAL_AUDIO_DIR=./audio_output

# Voice I/O (TTS / STT)
TTS_PROVIDER=edge-tts
STT_PROVIDER=speech_recognition
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
MAX_AUDIO_SIZE_MB=10

# Wearable Integration
WEARABLE_SYNC_ENABLED=true
WEARABLE_HEALTH_CONTEXT_DAYS=7
RETENTION_HEALTH_METRICS_DAYS=365

# RL / Thompson Sampling (Phase 17)
RL_ENABLED=true
RL_EXPLORATION_BONUS=0.5
RL_MIN_OUTCOMES_FOR_RL=3
RL_SUCCESS_THRESHOLD=4
RL_CACHE_TTL=300

# Fine-Tuning (Phase 18)
FT_ENABLED=false
FT_MODEL_ID=
FT_BASE_MODEL=gpt-4o-mini
FT_AB_SPLIT_PERCENT=50
FT_MIN_TRAINING_EXAMPLES=100
FT_MIN_FEEDBACK_RATING=helpful
FT_MIN_HELPFULNESS_SCORE=4
FT_TRAINING_EPOCHS=3
FT_RETENTION_TRAINING_DATA_DAYS=365

# Monitoring Dashboard (Phase 19)
DASHBOARD_ENABLED=true
DASHBOARD_CACHE_TTL=60
DASHBOARD_REFRESH_INTERVAL=30

# Human Escalation & Reviews (Phase 20)
ESCALATION_ENABLED=true
ESCALATION_REPEATED_HIGH_THRESHOLD=3
ESCALATION_REPEATED_HIGH_WINDOW_DAYS=7
REVIEW_ENABLED=true
REVIEW_DEFAULT_PERIOD_DAYS=365

# Assessment System (Phase 21)
ASSESSMENT_ENABLED=true
ASSESSMENT_REMINDER_DAYS=14
ASSESSMENT_WHO5_CONCERN_THRESHOLD=50
ASSESSMENT_PHQ9_CONCERN_THRESHOLD=10
ASSESSMENT_GAD7_CONCERN_THRESHOLD=10

# Data Retention (days) — GDPR/HIPAA Compliance
RETENTION_CHAT_SESSIONS_DAYS=365
RETENTION_MEMORIES_DAYS=730
RETENTION_FEEDBACK_DAYS=365
RETENTION_EXERCISE_SESSIONS_DAYS=365
RETENTION_SOUNDSCAPE_SESSIONS_DAYS=180
RETENTION_SAFETY_EVENTS_DAYS=730
RETENTION_INTERACTION_METRICS_DAYS=365
RETENTION_AUDIT_LOG_DAYS=2555
AUDIT_LOG_ENABLED=true

# Self-Care Score (Phase 22)
SELFCARE_SCORE_ENABLED=true
SELFCARE_MOOD_WINDOW_DAYS=14
SELFCARE_STREAK_CAP_DAYS=14
SELFCARE_BURNOUT_ENGAGEMENT_THRESHOLD=80.0
SELFCARE_BURNOUT_EFFECTIVENESS_THRESHOLD=30.0

# ───────────────────────── Lucille (Claude edition) ─────────────────────────
# 'openai' (default) keeps the app exactly as it ships today. 'claude' also mounts
# POST /v2/lucille/turn, /v2/lucille/approve, /v2/lucille/threads and /v2/plans/*.
LUCILLE_EDITION=openai

# Required for the Claude edition. Without it those routes answer
# 503 {"code":"claude_unavailable"} and /v2/plans falls back to the catalog provider.
ANTHROPIC_API_KEY=

# Models (platform.claude.com, Oct 2026). 1M context, 128K max output.
LUCILLE_CLAUDE_MODEL=claude-opus-5-5
LUCILLE_CLAUDE_FAST_MODEL=claude-haiku-5-5
LUCILLE_CLAUDE_CHEAP_MODEL=claude-sonnet-5-5
LUCILLE_CLAUDE_LONG_MODEL=claude-fable-5-1
LUCILLE_CLAUDE_LONG_REASONING=false
LUCILLE_CLAUDE_MAX_TOKENS=1600
LUCILLE_CLAUDE_TIMEOUT_S=60
LUCILLE_CLAUDE_MAX_RETRIES=2

# Memory since inception: verbatim window, memory top-k, fold-down threshold.
LUCILLE_CLAUDE_VERBATIM_TURNS=40
LUCILLE_CLAUDE_MEMORY_TOP_K=20
LUCILLE_CLAUDE_CONTEXT_BUDGET=400000
LUCILLE_CLAUDE_TOOL_ROUNDS=4
LUCILLE_CLAUDE_MEMORY_WRITE=true

# Per-user daily cost caps for the Claude edition.
QUOTA_CLAUDE_TURN_PER_DAY=60
QUOTA_CLAUDE_PLAN_PER_DAY=4
QUOTA_CLAUDE_DOC_PER_DAY=10

# Plan documents. With a bucket: written to plans/{uid}/{planId}/ and handed back as a
# signed URL. Without one: kept in the user's own Firestore tree and served by
# GET /v2/plans/{id}/documents/{docId} behind their token (never public).
LUCILLE_PLAN_DOCS_BUCKET=
LUCILLE_PLAN_DOCS_TTL_HOURS=24

# AI disclosure cadence (contract): adults 3h / 12 turns, teens 1h / 5 turns.
DISCLOSURE_HOURS_ADULT=3
DISCLOSURE_TURNS_ADULT=12
DISCLOSURE_HOURS_TEEN=1
DISCLOSURE_TURNS_TEEN=5
