# LucilleLLM Environment Configuration
# Copy this file to .env and fill in your values

# Required
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccount.json

# Authentication (service-to-service API key)
LUCILLE_API_KEY=your-api-key-here

# Environment
ENVIRONMENT=development

# Model configuration
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
FAISS_INDEX_PATH=./faiss_vecdb

# Rate limiting (requests per window)
RATE_LIMIT_CHAT=10
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTLs (seconds)
CACHE_TTL_USER_PROFILE=60
CACHE_TTL_EFFECTIVENESS=120
CACHE_TTL_EMOTION=300
CACHE_MAX_SIZE=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Metrics
METRICS_ENABLED=true

# Dependency Detection Thresholds
DEPENDENCY_MAX_MESSAGES_PER_HOUR=20
DEPENDENCY_MAX_SESSIONS_PER_DAY=8
DEPENDENCY_NIGHTTIME_START_HOUR=0
DEPENDENCY_NIGHTTIME_END_HOUR=5
DEPENDENCY_NIGHTTIME_THRESHOLD=5
DEPENDENCY_ESCALATION_RATIO=1.5
DEPENDENCY_CONSECUTIVE_DAYS_THRESHOLD=14
DEPENDENCY_COOLDOWN_MINUTES=30

# Cultural Competence
CULTURAL_BIAS_CHECK_ENABLED=true
CULTURAL_DEFAULT_COUNTRY=US

# Audio Storage (GCS)
GCS_AUDIO_BUCKET=your-bucket-name
GCS_AUDIO_PREFIX=soundscapes/
GCS_SIGNED_URL_EXPIRY_MINUTES=60

# Voice I/O (TTS / STT)
TTS_PROVIDER=edge-tts
STT_PROVIDER=speech_recognition
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
MAX_AUDIO_SIZE_MB=10

# Wearable Integration
WEARABLE_SYNC_ENABLED=true
WEARABLE_HEALTH_CONTEXT_DAYS=7
RETENTION_HEALTH_METRICS_DAYS=365

# RL / Thompson Sampling (Phase 17)
RL_ENABLED=true
RL_EXPLORATION_BONUS=0.5
RL_MIN_OUTCOMES_FOR_RL=3
RL_SUCCESS_THRESHOLD=4
RL_CACHE_TTL=300

# Fine-Tuning (Phase 18)
FT_ENABLED=false
FT_MODEL_ID=
FT_BASE_MODEL=gpt-4o-mini
FT_AB_SPLIT_PERCENT=50
FT_MIN_TRAINING_EXAMPLES=100
FT_MIN_FEEDBACK_RATING=helpful
FT_MIN_HELPFULNESS_SCORE=4
FT_TRAINING_EPOCHS=3
FT_RETENTION_TRAINING_DATA_DAYS=365

# Monitoring Dashboard (Phase 19)
DASHBOARD_ENABLED=true
DASHBOARD_CACHE_TTL=60
DASHBOARD_REFRESH_INTERVAL=30

# Human Escalation & Reviews (Phase 20)
ESCALATION_ENABLED=true
ESCALATION_REPEATED_HIGH_THRESHOLD=3
ESCALATION_REPEATED_HIGH_WINDOW_DAYS=7
REVIEW_ENABLED=true
REVIEW_DEFAULT_PERIOD_DAYS=365
