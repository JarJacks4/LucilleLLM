# Secrets — NEVER include in Docker image
.env
.env.*
*.pem
*.key
# `*.key` does NOT match `key.txt` — that gap shipped a live OpenAI key
# into every built image via `COPY . /app`. Match it explicitly.
key.txt
keys.txt
secrets.txt
*firebase*.json
*credentials*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Development
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore
.claude/

# IDE
.vscode/
.idea/

# Docs and non-runtime files
*.md
PHASE_4_TODO.md
LICENSE

# Tests (not needed in production image)
tests/

# Audio output from local dev
audio_output/

# Node modules (if any from Firebase CLI)
node_modules/
